{
  "name": "insurance-order-entry-playwright",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke --grep-invert @negative",
    "test:regression": "playwright test --grep @regression --grep-invert @negative",
    "test:negative": "playwright test --grep @negative",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report reports/html-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
